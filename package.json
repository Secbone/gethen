{
  "name": "gethen",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.26.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "gen": "node scripts/gen-aliases.mjs",
    "check:layering": "node scripts/check-layering.mjs",
    "dev": "tsx packages/cli/src/bin.ts",
    "build:dsh": "node scripts/build-dsh.mjs",
    "test:benchmarks": "node scripts/gen-aliases.mjs && vitest run packages/benchmark packages/benchmark-file",
    "test": "node scripts/gen-aliases.mjs && vitest run",
    "test:watch": "vitest",
    "typecheck": "node scripts/gen-aliases.mjs && tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test:architecture": "node --test scripts/check-layering.test.mjs",
    "test:audits": "python3 -m unittest discover -s benchmarks/past-bench -p 'test_*.py' && python3 -m unittest discover -s benchmarks/swe-bench -p 'test_*.py'",
    "check": "node scripts/gen-aliases.mjs && node scripts/check-layering.mjs && node --test scripts/check-layering.test.mjs && tsc --noEmit && pnpm typecheck:packages && vitest run && pnpm test:audits && biome check .",
    "typecheck:packages": "pnpm -r typecheck",
    "verify:escalation": "node scripts/verify-escalation.mjs",
    "dev:dsh": "node scripts/build-dsh.mjs --watch",
    "serve": "tsx packages/cli/src/bin.ts serve",
    "verify:ws": "node scripts/verify-ws.mjs",
    "e2e:sdk": "node scripts/e2e-sdk.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@types/node": "^24.10.1",
    "@types/ws": "^8.18.2",
    "esbuild": "0.28.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "ws": "^8.23.0"
  }
}
